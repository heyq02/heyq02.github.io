{
  "name": "rspress-doc-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run plugins:build && rspress build",
    "dev": "pnpm run plugins:build && rspress dev",
    "format": "prettier --write .",
    "lint": "rslint",
    "plugins:build": "pnpm --filter \"./plugins/*\" run build",
    "plugins:test": "pnpm --filter \"./plugins/*\" run test",
    "preview": "rspress preview"
  },
  "dependencies": {
    "@rspress/core": "2.0.22"
  },
  "devDependencies": {
    "@rslint/core": "0.9.2",
    "@rspress/plugin-rss": "2.0.22",
    "@rspress/plugin-sitemap": "2.0.22",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rspress-plugin-autometa": "workspace:*",
    "rspress-plugin-autonav": "workspace:*",
    "typescript": "6.0.3"
  }
}
